{
  "schemaVersion": {"major": 0, "minor": 1},
  "profile": {"selected": "workspace-live-development", "selectionIsVisible": true},
  "environment": {
    "packages": [{"source": {"kind": "nixInput", "input": "nixpkgs", "attribute": "hello"}}],
    "variables": {"EDITOR": "vi"},
    "activation": [["bash"]]
  },
  "workspace": {"destination": "/workspace", "materialization": "live", "allowedMaterializations": ["live"], "access": "readWrite"},
  "network": {"mode": "disabled", "egressAllow": [], "hardPolicy": {"allowedDestinations": []}},
  "secrets": [{"name": "agent-api-token", "delivery": ["environment"]}],
  "resources": {"memory": {"minimumBytes": 536870912, "maximumBytes": 4294967296}},
  "targets": ["firecracker"],
  "requiredCapabilities": ["network.disabled", "workspace.live"],
  "runtimeProfiles": {
    "firecracker-live": {"target": "firecracker", "materializations": ["live"]}
  },
  "extensions": {}
}
