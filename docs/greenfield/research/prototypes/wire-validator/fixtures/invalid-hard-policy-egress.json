{
  "schemaVersion": {"major": 0, "minor": 1},
  "profile": {"selected": "workspace-edit-offline", "selectionIsVisible": true},
  "environment": {
    "packages": [{"source": {"kind": "nixInput", "input": "nixpkgs", "attribute": "hello"}}],
    "variables": {"EDITOR": "vi"},
    "activation": [["bash"]]
  },
  "workspace": {"destination": "/workspace", "materialization": "copy", "allowedMaterializations": ["copy"], "access": "readWrite"},
  "network": {
    "mode": "egress",
    "egressAllow": ["api.example.test:443"],
    "hardPolicy": {"allowedDestinations": []}
  },
  "secrets": [{"name": "agent-api-token", "delivery": ["environment"]}],
  "resources": {"memory": {"minimumBytes": 536870912, "maximumBytes": 4294967296}},
  "targets": ["bubblewrap", "firecracker"],
  "requiredCapabilities": ["network.egress", "workspace.copy"],
  "runtimeProfiles": {
    "bubblewrap-copy": {"target": "bubblewrap", "materializations": ["copy"]},
    "firecracker-copy": {"target": "firecracker", "materializations": ["copy"]}
  },
  "extensions": {}
}
