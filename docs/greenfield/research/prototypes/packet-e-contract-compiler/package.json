{
  "name": "contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "peerDependencies": {
    "@typespec/compiler": "1.14.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@typespec/compiler": "1.14.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "emit": "node scripts/emit.mjs",
    "format:check": "tsp format --check lib test/fixtures",
    "golden:check": "pnpm build && node scripts/generated-golden.mjs --check",
    "golden:update": "pnpm build && node scripts/generated-golden.mjs --update",
    "test": "pnpm build && vitest",
    "test:generation:rust-go": "pnpm test --run test/generation.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
