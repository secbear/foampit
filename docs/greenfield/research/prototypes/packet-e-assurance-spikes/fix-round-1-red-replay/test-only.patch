+++ b/docs/greenfield/research/prototypes/packet-e-assurance-spikes/fix-round-1-red-replay/driver.sh
@@ -0,0 +1,90 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+spike="$(CDPATH= cd -- "$here/.." && pwd)"
+worktree="$(git -C "$spike" rev-parse --show-toplevel)"
+output="$(mktemp "${TMPDIR:-/tmp}/packet-e-red-output.XXXXXX")"
+failures=0
+trap 'unlink "$output"' EXIT
+cd "$spike"
+
+run_red() {
+  local name="$1"
+  local command_text="$2"
+  shift 2
+  local status
+  : >"$output"
+  "$@" >"$output" 2>&1
+  status=$?
+  printf 'CASE %s\n' "$name"
+  printf 'COMMAND %s\n' "$command_text"
+  printf 'EXIT %s\n' "$status"
+  printf 'OUTPUT\n'
+  sed -e "s|$spike|<SPIKE>|g" -e "s|$worktree|<WORKTREE>|g" "$output"
+  printf 'END %s\n' "$name"
+  if [[ "$status" -ne 1 ]]; then
+    printf 'REPLAY_ERROR expected exit 1, observed %s for %s\n' "$status" "$name" >&2
+    failures=$((failures + 1))
+  fi
+}
+
+for case_name in \
+  coordinated-source-model-replacement \
+  dependency-static-obfuscation \
+  dependency-reexport \
+  dependency-symlink-alias \
+  dependency-indirect-loading; do
+  run_red \
+    "normalization/$case_name" \
+    "node normalization/dependency-audit.mjs --case $case_name" \
+    node normalization/dependency-audit.mjs --case "$case_name"
+done
+
+for case_name in \
+  typed-proof-material-binding \
+  required-theorems-proof-bound \
+  contextual-arbitrary-carrier \
+  semantic-coverage-cardinality \
+  expr-alias-prop \
+  expr-arbitrary-prop \
+  expr-private-generated \
+  expr-implicit-prop \
+  expr-transparent-multihop \
+  pinned-dependency-wrong-pin; do
+  run_red \
+    "formal/$case_name" \
+    "node formal/audit.mjs --case $case_name" \
+    node formal/audit.mjs --case "$case_name"
+done
+
+for case_name in \
+  log-sequence-future \
+  log-sequence-stale \
+  log-sequence-duplicate \
+  observer-missing-database \
+  observer-extra-table \
+  observer-schema-shape; do
+  run_red \
+    "durability/$case_name" \
+    "python3 durability/crash_driver.py --case $case_name" \
+    python3 durability/crash_driver.py --case "$case_name"
+done
+
+for case_name in \
+  wrong-deriver \
+  lake-outside-lean \
+  library-outside-lean \
+  wrong-nixpkgs-source; do
+  run_red \
+    "toolchain/$case_name" \
+    "bash run.sh --toolchain-case $case_name" \
+    bash run.sh --toolchain-case "$case_name"
+done
+
+if (( failures != 0 )); then
+  printf 'RED replay failed: %s case(s) did not reproduce\n' "$failures" >&2
+  exit 1
+fi
+
+printf 'RED replay: PASS cases=25 base=6462aa751470cdd08d49f1792432871a17d35fb3\n'
