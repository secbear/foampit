import "../prototype.pkl"

hidden rendererSecret = "not-serialized"

local input = new prototype.ArtifactInput {
  environment = new prototype.Environment {
    packages = List()
    variables = Map("PLUGIN__DYNAMIC_KEY", "accepted")
    activation = List("bash")
  }
  workspace = new prototype.WorkspaceInput {
    destination = "/workspace"
  }
  network = new prototype.NetworkInput {
    hardPolicy = new prototype.HardPolicy {
      base = new prototype.PolicyDefinition {
        allowedDestinations = List()
        source = "fixture:base"
      }
    }
  }
  secrets = List()
  resources = new prototype.Resources {
    memory = new prototype.MemoryBounds {
      minimumBytes = 536870912
      maximumBytes = 4294967296
    }
  }
  targets = List("bubblewrap", "firecracker")
}

result = prototype.compile(input)
